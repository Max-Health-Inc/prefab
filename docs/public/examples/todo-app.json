{
  "$prefab": {
    "version": "0.3"
  },
  "view": {
    "type": "Card",
    "children": [
      {
        "type": "CardHeader",
        "children": [
          {
            "type": "CardTitle",
            "content": "Todo List"
          },
          {
            "type": "CardDescription",
            "content": "Tasks: {{ tasks | length }}"
          }
        ]
      },
      {
        "type": "CardContent",
        "children": [
          {
            "type": "Column",
            "cssClass": "gap-3",
            "children": [
              {
                "type": "Row",
                "cssClass": "gap-2",
                "children": [
                  {
                    "type": "Input",
                    "name": "newTask",
                    "placeholder": "What needs to be done?"
                  },
                  {
                    "type": "Button",
                    "label": "Add",
                    "onClick": [
                      {
                        "action": "appendState",
                        "key": "tasks",
                        "value": "{{ newTask }}"
                      },
                      {
                        "action": "setState",
                        "key": "newTask",
                        "value": ""
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Separator"
              },
              {
                "type": "ForEach",
                "expression": "{{ tasks }}",
                "children": [
                  {
                    "type": "Row",
                    "cssClass": "gap-2 items-center",
                    "children": [
                      {
                        "type": "Text",
                        "content": "• {{ $item }}"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "state": {
    "newTask": "",
    "tasks": [
      "Review pull requests",
      "Update documentation",
      "Deploy v2.0"
    ]
  }
}
